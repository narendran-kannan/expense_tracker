# =============================================================================
# DATABASE
# =============================================================================
# Vercel Postgres connection string (or any PostgreSQL URL)
# For local dev, use: postgresql://postgres:postgres@localhost:5432/expense_tracker
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-random-secret-here"

# The password to access your dashboard (pick something strong for production)
AUTH_PASSWORD="your-secure-password"

# =============================================================================
# AI - OpenRouter (Vercel AI SDK)
# =============================================================================
# All AI calls go through OpenRouter. Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-api-key"

# Optional model overrides (defaults shown). Any OpenRouter model id works, but
# with ZDR enabled it must have a Zero-Data-Retention endpoint:
# https://openrouter.ai/api/v1/endpoints/zdr
# Extraction: bank-alert emails, pasted text and XLSX import rows.
# OPENROUTER_MODEL_EXTRACTION="deepseek/deepseek-v4.1-flash-1017"
# Insights: analytics summaries over pre-computed stats.
# OPENROUTER_MODEL_INSIGHTS="google/gemini-3.5-flash-lite"

# Privacy (defaults shown). Requests only route to endpoints that do not retain
# the prompt and do not train on it. Set to "false" only if you accept retention —
# e.g. to run insights on google/gemini-2.5-pro, which has no ZDR endpoint.
# OPENROUTER_ZDR=true
# OPENROUTER_ZDR_INSIGHTS=true
# OPENROUTER_DENY_DATA_COLLECTION=true

# =============================================================================
# GMAIL API (for email parsing)
# =============================================================================
# Create OAuth 2.0 credentials for Gmail API access.
# Use https://developers.google.com/oauthplayground to get a refresh token.
# Enable the Gmail API in Google Cloud Console.
GMAIL_CLIENT_ID="your-gmail-oauth-client-id"
GMAIL_CLIENT_SECRET="your-gmail-oauth-client-secret"
GMAIL_REFRESH_TOKEN="your-gmail-refresh-token"

# Gmail search query. Leave blank to use the built-in query that targets:
#   - HDFC Bank alerts (from:alerts@hdfcbank.net OR from:alerts@hdfcbank.bank.in)
#   - IDFC FIRST Bank alerts (from:delivery.idfcfirstbank.com subject:"Debit Alert")
# Set this only if you want to override with a custom query.
# GMAIL_SEARCH_QUERY=""

# =============================================================================
# DELETED / IGNORED TRANSACTIONS
# =============================================================================
# Deleting a transaction leaves a tombstone so the overlapping Gmail search does
# not re-import it. Tombstones older than this are purged by the daily cron.
# IGNORED_RETENTION_DAYS="30"

# =============================================================================
# CRON SECURITY
# =============================================================================
# Secret to protect the /api/process-emails endpoint
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret"
