generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id                  String     @id @default(uuid())
  name                String
  parentId            String?
  excluded_from_spend Boolean    @default(false)
  parent              Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children            Category[] @relation("CategoryHierarchy")

  transactionsAsCategory    Transaction[] @relation("TransactionCategory")
  transactionsAsSubcategory Transaction[] @relation("TransactionSubcategory")

  @@unique([name, parentId])
}

model Transaction {
  id                 String      @id @default(uuid())
  amount             Float
  merchant           String
  date               DateTime
  category           String
  categoryId         String?
  subcategoryId      String?
  categoryRef        Category?   @relation("TransactionCategory", fields: [categoryId], references: [id])
  subcategoryRef     Category?   @relation("TransactionSubcategory", fields: [subcategoryId], references: [id])
  is_cc_payment      Boolean     @default(false)
  confidence_score   Float
  needs_review       Boolean     @default(true)
  email_message_id   String?     @unique
  remarks            String?
  source             String      @default("email")
  recoverable_amount Float?
  counterparty       String?
  recovery_status    String?
  group_id           String?
  is_emi             Boolean     @default(false)
  emi_tenure_months  Int?
  emi_monthly_amount Float?
  emi_start_date     DateTime?
  repayments         Repayment[]
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt

  @@index([amount, merchant, date], name: "idx_dedup")
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([recovery_status, counterparty])
  @@index([group_id])
  @@index([is_emi, emi_start_date])
}

model Repayment {
  id             String      @id @default(uuid())
  transaction_id String
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  amount         Float
  date           DateTime
  note           String?
  created_at     DateTime    @default(now())

  @@index([transaction_id])
}

model Budget {
  id          String   @id @default(uuid())
  amount      Float
  start_month Int
  start_year  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([start_month, start_year])
  @@index([start_year, start_month])
}

model BudgetOverage {
  id              String           @id @default(uuid())
  month           Int
  year            Int
  computed_amount Float?
  override_amount Float?
  owed_to         String?
  status          String           @default("outstanding")
  payments        OveragePayment[]
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  @@unique([month, year])
  @@index([year, month])
  @@index([status])
}

model OveragePayment {
  id         String        @id @default(uuid())
  overage_id String
  overage    BudgetOverage @relation(fields: [overage_id], references: [id], onDelete: Cascade)
  amount     Float
  date       DateTime
  note       String?
  created_at DateTime      @default(now())

  @@index([overage_id])
}

/// A soft-deleted transaction. Keeping this row is what stops the overlapping
/// Gmail search from re-importing the source email. The daily cron purges rows
/// older than IGNORED_RETENTION_DAYS (default 30).
model IgnoredTransaction {
  id                      String   @id @default(uuid())
  email_message_id        String?  @unique
  amount                  Float
  merchant                String
  date                    DateTime
  category                String
  is_cc_payment           Boolean  @default(false)
  match_fingerprint       Boolean  @default(false)
  reason                  String?
  source                  String   @default("transaction")
  original_transaction_id String?
  snapshot                Json?
  created_at              DateTime @default(now())

  @@index([created_at])
  @@index([amount, merchant, date])
}

model SkippedEmail {
  id               String   @id @default(uuid())
  email_message_id String   @unique
  subject          String
  sender           String
  body_snippet     String
  ai_reason        String?
  dismissed        Boolean  @default(false)
  created_at       DateTime @default(now())
}

/// A chunked email-pipeline run driven by the /debug page.
/// One run = the result of one Gmail search; `items` are processed in short
/// requests so a single HTTP call never hits the Cloudflare 100s ceiling.
model PipelineRun {
  id          String         @id @default(uuid())
  status      String         @default("pending") // pending | running | completed | failed | canceled
  dry_run     Boolean        @default(true)
  query       String
  limit       Int
  total_found Int            @default(0)
  driver      String         @default("debug") // "debug" | "cron"
  error       String?
  started_at  DateTime       @default(now())
  finished_at DateTime?
  items       PipelineItem[]

  @@index([status, started_at])
}

model PipelineItem {
  id               String      @id @default(uuid())
  run_id           String
  run              PipelineRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  email_message_id String
  status           String      @default("pending") // pending | processing | done | error | canceled
  result           Json?
  error            String?
  attempts         Int         @default(0)
  locked_at        DateTime?
  created_at       DateTime    @default(now())

  @@unique([run_id, email_message_id])
  @@index([run_id, status, created_at])
}

model Insight {
  id                      String   @id @default(uuid())
  period_type             String
  period_key              String
  month                   Int?
  year                    Int
  stats                   Json
  summary                 String
  trends                  Json
  anomalies               Json
  suggestions             Json
  tx_count_at_generation  Int
  tx_latest_at_generation DateTime
  model                   String   @default("gemini-2.5-pro")
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  @@unique([period_type, period_key])
  @@index([year, month])
}
